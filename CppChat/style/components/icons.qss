/* Lucide icon states. Geometry is owned by .ui; artwork is 24px on a 34px canvas. */

/* 聊天记录入口组合聊天气泡与向下箭头，画布为 54×34。 */
QDialog#ChatDialog #chat_page #chat_history_btn {
    border-image: url(:/icons/history-entry-normal.svg);
}

QDialog#ChatDialog #chat_page #chat_history_btn:hover,
QDialog#ChatDialog #chat_page #chat_history_btn:pressed {
    border-image: url(:/icons/history-entry-hover.svg);
}

QDialog#ChatDialog #add_btn {
    border-image: url(:/icons/circle-plus-normal.svg);
}

QDialog#ChatDialog #add_btn:hover,
QDialog#ChatDialog #add_btn:pressed {
    border-image: url(:/icons/circle-plus-hover.svg);
}

QDialog#ChatDialog #side_head_btn,
QDialog#ChatDialog #side_chat_btn,
QDialog#ChatDialog #side_contact_btn,
QDialog#ChatDialog #side_favorites_btn,
QDialog#ChatDialog #side_discover_btn,
QDialog#ChatDialog #side_phone_btn,
QDialog#ChatDialog #side_menu_btn,
QDialog#ChatDialog #add_btn,
QDialog#ChatDialog #chat_page #emo_btn,
QDialog#ChatDialog #chat_page #favorites_btn,
QDialog#ChatDialog #chat_page #file_btn,
QDialog#ChatDialog #chat_page #screenshot_btn,
QDialog#ChatDialog #chat_page #voice_transcribe_btn,
QDialog#ChatDialog #chat_page #call_btn,
QDialog#ChatDialog #chat_page #voice_message_btn,
QDialog#ChatDialog #chat_page #chat_history_btn,
QDialog#ChatDialog #chat_page #chat_more_btn {
    background: transparent;
    border: none;
    border-radius: ${radius.control};
    padding: 0;
}

QDialog#ChatDialog #side_chat_btn:hover,
QDialog#ChatDialog #side_contact_btn:hover,
QDialog#ChatDialog #side_favorites_btn:hover,
QDialog#ChatDialog #side_discover_btn:hover,
QDialog#ChatDialog #side_phone_btn:hover,
QDialog#ChatDialog #side_menu_btn:hover {
    background-color: #d6d7d9;
}

QDialog#ChatDialog #side_chat_btn:pressed,
QDialog#ChatDialog #side_contact_btn:pressed,
QDialog#ChatDialog #side_favorites_btn:pressed,
QDialog#ChatDialog #side_discover_btn:pressed,
QDialog#ChatDialog #side_phone_btn:pressed,
QDialog#ChatDialog #side_menu_btn:pressed {
    background-color: #cbccce;
}

QDialog#ChatDialog #chat_page #emo_btn:hover,
QDialog#ChatDialog #chat_page #favorites_btn:hover,
QDialog#ChatDialog #chat_page #file_btn:hover,
QDialog#ChatDialog #chat_page #screenshot_btn:hover,
QDialog#ChatDialog #chat_page #voice_transcribe_btn:hover,
QDialog#ChatDialog #chat_page #call_btn:hover,
QDialog#ChatDialog #chat_page #voice_message_btn:hover,
QDialog#ChatDialog #chat_page #chat_more_btn:hover,
QDialog#ChatDialog #chat_page #chat_history_btn:hover,
QDialog#ChatDialog #add_btn:hover {
    background-color: ${color.surface.hover};
}

QDialog#ChatDialog #chat_page #emo_btn:pressed,
QDialog#ChatDialog #chat_page #file_btn:pressed,
QDialog#ChatDialog #chat_page #favorites_btn:pressed,
QDialog#ChatDialog #chat_page #screenshot_btn:pressed,
QDialog#ChatDialog #chat_page #voice_transcribe_btn:pressed,
QDialog#ChatDialog #chat_page #call_btn:pressed,
QDialog#ChatDialog #chat_page #voice_message_btn:pressed,
QDialog#ChatDialog #chat_page #chat_more_btn:pressed,
QDialog#ChatDialog #chat_page #chat_history_btn:pressed,
QDialog#ChatDialog #add_btn:pressed {
    background-color: ${color.surface.pressed};
}

QDialog#ChatDialog #side_chat_btn {
    border-image: url(:/icons/message-circle-normal.svg);
}

QDialog#ChatDialog #side_chat_btn:hover,
QDialog#ChatDialog #side_chat_btn:pressed {
    border-image: url(:/icons/message-circle-hover.svg);
}

QDialog#ChatDialog #side_chat_btn:checked,
QDialog#ChatDialog #side_chat_btn:checked:hover,
QDialog#ChatDialog #side_chat_btn:checked:pressed {
    border-image: url(:/icons/message-circle-selected.svg);
}

QDialog#ChatDialog #side_contact_btn {
    border-image: url(:/icons/contact-round-normal.svg);
}

QDialog#ChatDialog #side_contact_btn:hover,
QDialog#ChatDialog #side_contact_btn:pressed {
    border-image: url(:/icons/contact-round-hover.svg);
}

QDialog#ChatDialog #side_contact_btn:checked,
QDialog#ChatDialog #side_contact_btn:checked:hover,
QDialog#ChatDialog #side_contact_btn:checked:pressed {
    border-image: url(:/icons/contact-round-selected.svg);
}

QDialog#ChatDialog #side_favorites_btn {
    border-image: url(:/icons/bookmark-normal.svg);
}

QDialog#ChatDialog #side_favorites_btn:hover,
QDialog#ChatDialog #side_favorites_btn:pressed {
    border-image: url(:/icons/bookmark-hover.svg);
}

QDialog#ChatDialog #side_favorites_btn:checked,
QDialog#ChatDialog #side_favorites_btn:checked:hover,
QDialog#ChatDialog #side_favorites_btn:checked:pressed {
    border-image: url(:/icons/bookmark-selected.svg);
}

QDialog#ChatDialog #side_discover_btn {
    border-image: url(:/icons/compass-normal.svg);
}

QDialog#ChatDialog #side_discover_btn:hover,
QDialog#ChatDialog #side_discover_btn:pressed {
    border-image: url(:/icons/compass-hover.svg);
}

QDialog#ChatDialog #side_discover_btn:checked,
QDialog#ChatDialog #side_discover_btn:checked:hover,
QDialog#ChatDialog #side_discover_btn:checked:pressed {
    border-image: url(:/icons/compass-selected.svg);
}

QDialog#ChatDialog #side_phone_btn {
    border-image: url(:/icons/smartphone-normal.svg);
}

QDialog#ChatDialog #side_phone_btn:hover,
QDialog#ChatDialog #side_phone_btn:pressed {
    border-image: url(:/icons/smartphone-hover.svg);
}

QDialog#ChatDialog #side_menu_btn {
    border-image: url(:/icons/menu-normal.svg);
}

QDialog#ChatDialog #side_menu_btn:hover,
QDialog#ChatDialog #side_menu_btn:pressed {
    border-image: url(:/icons/menu-hover.svg);
}

QDialog#ChatDialog #chat_page #chat_more_btn {
    border-image: url(:/icons/ellipsis-normal.svg);
}

QDialog#ChatDialog #chat_page #chat_more_btn:hover,
QDialog#ChatDialog #chat_page #chat_more_btn:pressed {
    border-image: url(:/icons/ellipsis-hover.svg);
}

QDialog#ChatDialog #chat_page #favorites_btn {
    border-image: url(:/icons/bookmark-normal.svg);
}

QDialog#ChatDialog #chat_page #favorites_btn:hover,
QDialog#ChatDialog #chat_page #favorites_btn:pressed {
    border-image: url(:/icons/bookmark-hover.svg);
}

QDialog#ChatDialog #chat_page #screenshot_btn {
    border-image: url(:/icons/scissors-normal.svg);
}

QDialog#ChatDialog #chat_page #screenshot_btn:hover,
QDialog#ChatDialog #chat_page #screenshot_btn:pressed {
    border-image: url(:/icons/scissors-hover.svg);
}

QDialog#ChatDialog #chat_page #voice_transcribe_btn {
    border-image: url(:/icons/mic-normal.svg);
}

QDialog#ChatDialog #chat_page #voice_transcribe_btn:hover,
QDialog#ChatDialog #chat_page #voice_transcribe_btn:pressed {
    border-image: url(:/icons/mic-hover.svg);
}

QDialog#ChatDialog #chat_page #emo_btn {
    border-image: url(:/icons/smile-normal.svg);
}

QDialog#ChatDialog #chat_page #emo_btn:hover,
QDialog#ChatDialog #chat_page #emo_btn:pressed {
    border-image: url(:/icons/smile-hover.svg);
}

/* 选中状态只跟随表情面板的显示状态，关闭后不残留。 */
QDialog#ChatDialog #chat_page #emo_btn:checked {
    background-color: #dff3e8;
    border-image: url(:/icons/smile-hover.svg);
}

QDialog#ChatDialog #chat_page #file_btn {
    border-image: url(:/icons/folder-open-normal.svg);
}

QDialog#ChatDialog #chat_page #file_btn:hover,
QDialog#ChatDialog #chat_page #file_btn:pressed {
    border-image: url(:/icons/folder-open-hover.svg);
}

/* 红点是按钮上的显示标签，不拦截鼠标点击。 */
QDialog#ChatDialog #side_bar #chat_unread_dot,
QDialog#ChatDialog #side_bar #contact_unread_dot {
    background: #fa5151;
    border: none;
    border-radius: ${radius.dot};
}

/* 通话入口和语音消息沿用同一 34px 画布及灰色状态。 */
QDialog#ChatDialog #chat_page #call_btn {
    border-image: url(:/icons/call-entry-normal.svg);
}

QDialog#ChatDialog #chat_page #call_btn:hover,
QDialog#ChatDialog #chat_page #call_btn:pressed {
    border-image: url(:/icons/call-entry-hover.svg);
}

QDialog#ChatDialog #chat_page #call_btn::menu-indicator {
    image: none;
    width: 0;
}

QDialog#ChatDialog #chat_page #voice_message_btn {
    border-image: url(:/icons/voice-message-normal.svg);
}

QDialog#ChatDialog #chat_page #voice_message_btn:hover,
QDialog#ChatDialog #chat_page #voice_message_btn:pressed {
    border-image: url(:/icons/voice-message-hover.svg);
}
