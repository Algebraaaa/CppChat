/* Shared scrollbars for chat and contact lists. */

QDialog#ChatDialog #smooth_scrollbar:vertical,
ChatPage #chat_view_scrollbar:vertical {
    background-color: transparent;
    border: none;
    width: 8px;
    margin: 0;
}

QDialog#ChatDialog #smooth_scrollbar::handle:vertical,
ChatPage #chat_view_scrollbar::handle:vertical {
    background-color: ${color.scrollbar};
    min-height: 30px;
    border: none;
    border-radius: ${radius.dot};
}

QDialog#ChatDialog #smooth_scrollbar::handle:vertical:hover,
ChatPage #chat_view_scrollbar::handle:vertical:hover {
    background-color: ${color.scrollbar.hover};
}

QDialog#ChatDialog #smooth_scrollbar::handle:vertical:pressed,
ChatPage #chat_view_scrollbar::handle:vertical:pressed {
    background-color: ${color.scrollbar.pressed};
}

QDialog#ChatDialog #smooth_scrollbar::add-line:vertical,
QDialog#ChatDialog #smooth_scrollbar::sub-line:vertical,
ChatPage #chat_view_scrollbar::add-line:vertical,
ChatPage #chat_view_scrollbar::sub-line:vertical {
    height: 0;
    border: none;
    background-color: transparent;
}

QDialog#ChatDialog #smooth_scrollbar::add-page:vertical,
QDialog#ChatDialog #smooth_scrollbar::sub-page:vertical,
ChatPage #chat_view_scrollbar::add-page:vertical,
ChatPage #chat_view_scrollbar::sub-page:vertical {
    background-color: transparent;
    border: none;
}
