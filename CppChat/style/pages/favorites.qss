/* Account-local favorites. Static layout remains in favoritespage.ui. */

FavoritesPage {
    background: ${color.surface.page};
    color: ${color.text.primary};
}

FavoritesPage #favorites_filter_panel {
    background: ${color.panel};
    border-right: 1px solid ${color.border.card};
}

FavoritesPage #favorites_search_box {
    background: ${color.surface};
    border: 1px solid transparent;
    border-radius: ${radius.avatar};
}

FavoritesPage #favorites_search_icon {
    border-image: url(:/icons/action-search.svg);
}

FavoritesPage #favorites_search_edit {
    background: transparent;
    border: none;
    color: ${color.text.body};
    font-size: ${font.size.label};
    selection-background-color: ${color.selection};
}

FavoritesPage #write_note_btn,
FavoritesPage #favorite_all_btn,
FavoritesPage #favorite_recent_btn,
FavoritesPage #favorite_link_btn,
FavoritesPage #favorite_media_btn,
FavoritesPage #favorite_message_btn,
FavoritesPage #favorite_audio_btn {
    background: transparent;
    border: none;
    border-radius: ${radius.avatar};
    color: ${color.text.body};
    font-size: ${font.size.message};
    text-align: left;
    padding-left: 16px;
}

FavoritesPage #write_note_btn {
    background: ${color.surface};
    qproperty-icon: url(:/icons/action-note.svg);
    text-align: center;
    padding-left: 0;
}

FavoritesPage #favorite_all_btn {
    qproperty-icon: url(:/icons/favorites-grid.svg);
}

FavoritesPage #favorite_all_btn:checked {
    background: ${color.brand};
    color: ${color.text.onBrand};
    qproperty-icon: url(:/icons/favorites-grid-selected.svg);
}

FavoritesPage #favorite_recent_btn {
    qproperty-icon: url(:/icons/favorites-clock.svg);
}

FavoritesPage #favorite_link_btn {
    qproperty-icon: url(:/icons/favorites-link.svg);
}

FavoritesPage #favorite_media_btn {
    qproperty-icon: url(:/icons/favorites-image.svg);
}

FavoritesPage #favorite_message_btn {
    qproperty-icon: url(:/icons/favorites-message.svg);
}

FavoritesPage #favorite_audio_btn {
    qproperty-icon: url(:/icons/favorites-audio.svg);
}

FavoritesPage #write_note_btn:hover,
FavoritesPage #favorite_recent_btn:hover,
FavoritesPage #favorite_link_btn:hover,
FavoritesPage #favorite_media_btn:hover,
FavoritesPage #favorite_message_btn:hover,
FavoritesPage #favorite_audio_btn:hover {
    background: ${color.panel};
}

FavoritesPage #write_note_btn:pressed,
FavoritesPage #favorite_recent_btn:pressed,
FavoritesPage #favorite_link_btn:pressed,
FavoritesPage #favorite_media_btn:pressed,
FavoritesPage #favorite_message_btn:pressed,
FavoritesPage #favorite_audio_btn:pressed {
    background: ${color.surface.hover};
}

FavoritesPage #favorites_divider {
    color: ${color.text.disabled};
    background: ${color.surface.hover};
    border: none;
    max-height: 1px;
    margin: 7px 4px;
}

FavoritesPage #favorites_storage_lb {
    color: ${color.text.muted};
    font-size: ${font.size.caption};
}

FavoritesPage #favorites_content_panel,
FavoritesPage #favorites_scroll_area,
FavoritesPage #favorites_scroll_content {
    background: ${color.surface.subtle};
    border: none;
}

FavoritesPage #favorites_header {
    background: ${color.surface};
    border-bottom: 1px solid ${color.border.card};
}

FavoritesPage #favorites_title_lb {
    color: ${color.text.body};
    font-size: ${font.size.section};
    font-weight: ${font.weight.medium};
}

FavoritesPage #favoritesList {
    background: ${color.surface.subtle};
    color: ${color.text.body};
    font-size: ${font.size.message};
    border: none;
    padding: 8px 16px;
    outline: none;
}

FavoritesPage #favoritesList::item {
    background: ${color.surface};
    border: 1px solid ${color.border.subtle};
    border-radius: ${radius.card};
    padding: 12px 16px;
    margin: 6px 0;
}

FavoritesPage #favoritesList::item:hover {
    background: ${color.surface.hover};
}

FavoritesPage #favoritesList::item:selected {
    background: ${color.selection};
    color: ${color.text.body};
    border-color: ${color.brand};
}

FavoritesPage #favoritesStatus {
    padding: 8px 20px;
    color: ${color.text.muted};
    font-size: ${font.size.label};
}

FavoritesPage #favoriteOpen,
FavoritesPage #favoriteSend,
FavoritesPage #favoriteRemove,
FavoritesPage #favoritesLoadMore {
    background: ${color.surface};
    color: ${color.text.body};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.control};
    padding: 6px 12px;
    min-height: 22px;
}

FavoritesPage #favoriteOpen:disabled,
FavoritesPage #favoriteSend:disabled,
FavoritesPage #favoriteRemove:disabled,
FavoritesPage #write_note_btn:disabled {
    color: ${color.text.muted};
}

FavoritesPage #favorites_scroll_area QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 8px;
    margin: 4px 2px 4px 0;
}

FavoritesPage #favorites_scroll_area QScrollBar::handle:vertical {
    background: ${color.scrollbar};
    min-height: 30px;
    border: none;
    border-radius: ${radius.dot};
}

FavoritesPage #favorites_scroll_area QScrollBar::handle:vertical:hover {
    background: ${color.scrollbar.hover};
}

FavoritesPage #favorites_scroll_area QScrollBar::add-line:vertical,
FavoritesPage #favorites_scroll_area QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
    border: none;
}

FavoritesPage #favorites_scroll_area QScrollBar::add-page:vertical,
FavoritesPage #favorites_scroll_area QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}
