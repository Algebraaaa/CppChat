/* Contact list, search results and friend applications. */

QDialog#ChatDialog #search_list {
    background-color: ${color.surface.subtle};
    border: none;
}

QDialog#ChatDialog #search_list::item:selected {
    background-color: ${color.panel};
    border: none;
    outline: none;
}

QDialog#ChatDialog #search_list::item:hover:!selected {
    background-color: ${color.surface.page};
    border: none;
    outline: none;
}

QDialog#ChatDialog #search_list::item:selected:hover {
    background-color: ${color.panel};
}

QDialog#ChatDialog #search_list:focus {
    border: none;
    outline: none;
}

QDialog#ChatDialog #search_list QLabel#search_empty_tip {
    color: ${color.text.muted};
    background-color: transparent;
    font-size: ${font.size.label};
}

/* Address book: full-width sections and delegate-painted contact rows. */
QDialog#ChatDialog #contact_manage_btn {
    background: ${color.surface.subtle};
    border: none;
    border-radius: ${radius.avatar};
    color: ${color.text.primary};
    font-size: ${font.size.message};
}

QDialog#ChatDialog #contact_manage_btn:hover {
    background: ${color.surface};
}

QDialog#ChatDialog #contact_manage_btn:pressed {
    background: ${color.panel};
}

QDialog#ChatDialog #con_user_list {
    background: ${color.panel};
    border: none;
    padding: 10px 0 0 0;
    color: ${color.text.primary};
    font-size: ${font.size.message};
    selection-color: ${color.text.onBrand};
    selection-background-color: ${color.list.selected};
    qproperty-secondaryColor: ${color.text.muted};
    qproperty-dividerColor: ${color.border.card};
    qproperty-applicationSelectionColor: ${color.panel};
}

QDialog#ChatDialog #con_user_list::item {
    border: none;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QDialog#ChatDialog #con_user_list::item:hover:!selected {
    background: ${color.panel};
}

QDialog#ChatDialog #con_user_list::item:selected {
    background: ${color.list.selected};
    color: ${color.text.onBrand};
}

QDialog#ChatDialog #con_user_list::item:selected:hover {
    background: ${color.list.selected.hover};
}

QDialog#ChatDialog #con_user_list:focus {
    border: none;
    outline: none;
}

QDialog#ChatDialog #contact_placeholder_page {
    background: ${color.surface.subtle};
}

QDialog#ChatDialog #contact_placeholder_page QLabel {
    background: transparent;
}

QDialog#ChatDialog #contact_placeholder_page #placeholder_title {
    color: ${color.text.primary};
    font-size: ${font.size.section};
}

QDialog#ChatDialog #contact_placeholder_page #placeholder_description {
    color: ${color.text.muted};
    font-size: ${font.size.base};
}

QDialog#ChatDialog #friend_apply_page #friend_apply_lb {
    font-size: ${font.size.section};
    font-weight: ${font.weight.normal};
}

QDialog#ChatDialog #friend_apply_page #apply_hint {
    color: ${color.text.muted};
    font-size: ${font.size.base};
    padding: 24px;
}

QDialog#ChatDialog #friend_apply_page #friend_apply_wid {
    background-color: ${color.surface.page};
    border-bottom: 1px solid ${color.border.card};
}

QDialog#ChatDialog #friend_apply_page #apply_friend_list {
    background-color: ${color.surface.page};
    border-left: 1px solid ${color.border.card};
    border-top: none;
    border-right: none;
    border-bottom: none;
}

ApplyFriendItem#ApplyFriendItem {
    background-color: ${color.surface.page};
    border-bottom: 2px solid ${color.border.card};
}

ApplyFriendItem#ApplyFriendItem #user_chat_lb {
    color: ${color.text.muted};
    font-size: ${font.size.base};
}

ApplyFriendItem#ApplyFriendItem #addBtn[state='normal'] {
    background-color: ${color.surface.pressed};
    color: ${color.secondary.text};
    font-size: ${font.size.subheading};
    border-radius: ${radius.pill};
}

ApplyFriendItem#ApplyFriendItem #addBtn[state='hover'] {
    background-color: ${color.surface.pressed};
    color: ${color.secondary.text};
    font-size: ${font.size.subheading};
    border-radius: ${radius.pill};
}

ApplyFriendItem#ApplyFriendItem #addBtn[state='press'] {
    background-color: ${color.surface.pressed};
    color: ${color.secondary.text};
    font-size: ${font.size.subheading};
    border-radius: ${radius.pill};
}

ApplyFriendItem#ApplyFriendItem #already_add_lb {
    color: ${color.text.muted};
    font-size: ${font.size.small};
}

ApplyFriendItem#ApplyFriendItem #user_name_lb {
    color: ${color.text.body};
    font-size: ${font.size.subheading};
    font-weight: ${font.weight.normal};
}
