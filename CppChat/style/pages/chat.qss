/* Conversation list, chat header, composer, messages and delivery status. */

FileBubble#fileBubble QPushButton {
    background: transparent;
    border: none;
    color: ${color.text.body};
    padding: 4px 2px;
    text-align: left;
}
FileBubble#fileBubble QPushButton:hover { color: ${color.brand}; }
FileBubble#fileBubble QPushButton:disabled { color: ${color.text.muted}; }

QDialog#ChatDialog {
    background: ${color.surface.page};
    color: ${color.text.primary};
}

QDialog#ChatDialog #side_bar {
    background-color: ${color.sidebar};
    border: none;
}

QDialog#ChatDialog #search_wid {
    background-color: ${color.panel};
    border: none;
}

QDialog#ChatDialog #search_edit {
    background: ${color.surface};
    color: ${color.text.body};
    border: 1px solid ${color.border.input};
    border-radius: ${radius.avatar};
    padding: 0 9px;
    font-size: ${font.size.label};
    selection-background-color: ${color.selection};
}

QDialog#ChatDialog #search_edit:hover {
    background: ${color.surface};
    border-color: ${color.border.input.hover};
}

QDialog#ChatDialog #search_edit:focus {
    background: ${color.surface};
    border-color: ${color.brand};
}

QDialog#ChatDialog #chat_user_wid,
QDialog#ChatDialog #contacts_list_wid {
    background-color: ${color.panel};
}

QDialog#ChatDialog QSplitter#main_splitter::handle,
QDialog#ChatDialog QSplitter#contact_splitter::handle {
    background: transparent;
    border: none;
}

QDialog#ChatDialog #chat_user_list {
    background-color: ${color.panel};
    border: none;
    padding: 0;
}

QDialog#ChatDialog #chat_user_list::item {
    background-color: transparent;
    border: none;
    border-radius: ${radius.square};
    margin: 0;
}

QDialog#ChatDialog #chat_user_list::item:hover:!selected {
    background-color: ${color.surface.hover};
}

QDialog#ChatDialog #chat_user_list::item:pressed:!selected {
    background-color: ${color.surface.pressed};
}

QDialog#ChatDialog #chat_user_list::item:selected {
    background-color: ${color.list.selected};
    border: none;
}

QDialog#ChatDialog #chat_user_list::item:selected:hover {
    background-color: ${color.list.selected.hover};
}

QDialog#ChatDialog #chat_user_list::item:selected:pressed {
    background-color: ${color.list.selected.pressed};
}

QDialog#ChatDialog #chat_user_list:focus {
    border: none;
    outline: none;
}

ChatUserWid {
    background-color: transparent;
    border: none;
}

ChatUserWid#ChatUserWid #user_chat_lb {
    color: ${color.text.preview};
    font-size: ${font.size.label};
}

ChatUserWid#ChatUserWid #user_name_lb {
    color: ${color.text.primary};
    font-size: ${font.size.message};
    font-weight: ${font.weight.medium};
}

ChatUserWid#ChatUserWid #time_lb {
    color: ${color.text.muted};
    font-size: ${font.size.caption};
}

ChatUserWid#ChatUserWid #user_name_lb[selected="true"],
ChatUserWid#ChatUserWid #user_chat_lb[selected="true"],
ChatUserWid#ChatUserWid #time_lb[selected="true"] {
    color: ${color.text.onBrand};
}

ChatUserWid#ChatUserWid #icon_lb {
    background: ${color.surface.page};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.avatar};
}

ChatPage #messageSelectionBar {
    background: ${color.surface};
    border-bottom: 1px solid ${color.border.subtle};
}

ChatPage #messageSelectionBar QPushButton {
    background: ${color.surface};
    color: ${color.text.body};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.control};
    padding: 5px 12px;
    min-height: 24px;
}

ChatPage #messageSelectionBar QPushButton:disabled {
    color: ${color.text.muted};
}

ChatPage,
ChatPage #chat_data_wid {
    background: ${color.surface.page};
}

ChatPage #composer_wid {
    background: ${color.surface.page};
    border: none;
}

/* 输入区独立卡片：外边距在 .ui 中，编辑框和底部工具栏共用背景。 */
ChatPage #composer_card {
    background: ${color.surface.subtle};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.card};
}

ChatPage QSplitter#chat_splitter::handle {
    background: transparent;
    border: none;
}

ChatPage #title_wid {
    background: ${color.surface.page};
    border-bottom: 1px solid ${color.border.card};
}

ChatPage #title_label {
    color: ${color.text.primary};
    font-size: ${font.size.heading};
    font-weight: ${font.weight.medium};
}

ChatPage #chatEdit {
    background-color: transparent;
    border: none;
    color: ${color.text.body};
    font-size: ${font.size.message};
    padding: 4px 6px;
    selection-background-color: ${color.selection};
}

ChatPage #chatEdit:disabled {
    color: ${color.text.disabled};
    background: transparent;
}

ChatPage #tool_wid {
    background-color: transparent;
    border: none;
}

ChatPage #send_btn {
    background-color: ${color.surface.page};
    color: ${color.secondary.text};
    font-size: ${font.size.message};
    font-weight: ${font.weight.medium};
    border: 1px solid ${color.surface.pressed};
    border-radius: ${radius.avatar};
}

ChatPage #send_btn:hover:enabled {
    background-color: ${color.panel};
}

ChatPage #send_btn:pressed:enabled {
    background-color: ${color.surface.hover};
}

ChatPage #send_btn:disabled {
    background-color: ${color.surface.page};
    color: ${color.text.disabled};
    border-color: ${color.border.card};
}

ChatPage #chat_data_list,
ChatPage #chat_bg {
    background-color: ${color.surface.page};
}

ChatPage #chat_area {
    border: none;
}

ChatPage #chat_user_name {
    color: ${color.text.muted};
    font-size: ${font.size.label};
}

ChatPage QLabel#chat_time_separator {
    color: ${color.text.muted};
    background: transparent;
    font-size: ${font.size.small};
    padding: 8px 0 5px 0;
}

ChatPage QLabel#message_status {
    color: ${color.text.muted};
    font-size: ${font.size.caption};
    background: transparent;
}

ChatPage QLabel#message_status[failed="true"] {
    color: ${color.status.error};
}

ChatPage QLabel#chat_status {
    background: ${color.status.warning.surface};
    color: ${color.status.warning.text};
    border: none;
    border-bottom: 1px solid ${color.status.warning.border};
    padding: 7px 22px;
    font-size: ${font.size.small};
}

QDialog#ChatDialog #chat_user_list QLabel#unread_dot {
    background: ${color.status.badge};
    border: none;
    border-radius: ${radius.dot};
}

/* ChatSettingsPanel（chatsettingspanel.ui）：悬浮于聊天内容右侧，不占布局宽度。
   位置由 QPropertyAnimation 平移；背景和左边界明确区分抽屉与聊天内容。 */
ChatPage ChatSettingsPanel {
    background: ${color.surface.subtle};
    border: none;
    border-left: 1px solid ${color.border.card};
}

ChatPage ChatSettingsPanel QWidget,
ChatPage ChatSettingsPanel QLabel {
    background: transparent;
    border: none;
    color: ${color.text.primary};
    font-size: ${font.size.message};
}

ChatPage ChatSettingsPanel #member_name,
ChatPage ChatSettingsPanel #add_member_label {
    color: ${color.text.muted};
    font-size: ${font.size.label};
}

ChatPage ChatSettingsPanel #settings_separator_1,
ChatPage ChatSettingsPanel #settings_separator_2,
ChatPage ChatSettingsPanel #settings_separator_3 {
    background: ${color.border.subtle};
    border: none;
}

ChatPage ChatSettingsPanel QPushButton {
    background: transparent;
    border: none;
    border-radius: ${radius.control};
    color: ${color.text.primary};
    font-size: ${font.size.message};
    padding: 0;
}

ChatPage ChatSettingsPanel QPushButton:hover {
    background: ${color.surface.hover};
}

ChatPage ChatSettingsPanel QPushButton:pressed {
    background: ${color.surface.pressed};
}

ChatPage ChatSettingsPanel #add_member_btn {
    border: 1px dashed ${color.border.card};
    border-radius: ${radius.compact};
}

ChatPage ChatSettingsPanel #find_content_btn {
    text-align: left;
}

ChatPage ChatSettingsPanel #clear_history_btn {
    color: ${color.status.error};
}

/* QCheckBox 原生维护 :checked 状态，用两张 SVG 实现开关，不需要自定义 state。 */
ChatPage ChatSettingsPanel QCheckBox {
    background: transparent;
    border: none;
    spacing: 0;
    padding: 0;
}

ChatPage ChatSettingsPanel QCheckBox::indicator {
    width: 40px;
    height: 24px;
    border: none;
    image: url(:/icons/settings-switch-off.svg);
}

ChatPage ChatSettingsPanel QCheckBox::indicator:checked {
    image: url(:/icons/settings-switch-on.svg);
}

/* 标题栏通话菜单由 Qt 管理键盘、焦点、屏幕边界和关闭行为。 */
QMenu#chat_call_menu {
    background: ${color.surface};
    color: ${color.text.primary};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.panel};
    padding: 6px;
    font-size: ${font.size.base};
}

QMenu#chat_call_menu::item {
    border-radius: ${radius.compact};
    padding: 10px 24px 10px 12px;
}

QMenu#chat_call_menu::item:selected {
    background: ${color.surface.hover};
}
