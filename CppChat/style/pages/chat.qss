/* Conversation list, chat header, composer, messages and delivery status. */

QDialog#ChatDialog {
    background: #f5f5f5;
    color: ${color.text.primary};
}

QDialog#ChatDialog #side_bar {
    background-color: #e1e1e7;
    border: none;
}

QDialog#ChatDialog #search_wid {
    background-color: #ededee;
    border: none;
}

QDialog#ChatDialog #search_edit {
    background: ${color.surface};
    color: ${color.text.body};
    border: 1px solid ${color.border.input};
    border-radius: ${radius.avatar};
    padding: 0 9px;
    font-size: ${font.size.label};
    selection-background-color: ${color.selection};
}

QDialog#ChatDialog #search_edit:hover {
    background: ${color.surface};
    border-color: ${color.border.input.hover};
}

QDialog#ChatDialog #search_edit:focus {
    background: ${color.surface};
    border-color: ${color.brand};
}

QDialog#ChatDialog #chat_user_wid,
QDialog#ChatDialog #contacts_list_wid {
    background-color: #ededee;
}

QDialog#ChatDialog QSplitter#main_splitter::handle,
QDialog#ChatDialog QSplitter#contact_splitter::handle {
    background: transparent;
    border: none;
}

QDialog#ChatDialog #chat_user_list {
    background-color: #ededee;
    border: none;
    padding: 0;
}

QDialog#ChatDialog #chat_user_list::item {
    background-color: transparent;
    border: none;
    border-radius: ${radius.square};
    margin: 0;
}

QDialog#ChatDialog #chat_user_list::item:hover:!selected {
    background-color: #dedfe0;
}

QDialog#ChatDialog #chat_user_list::item:pressed:!selected {
    background-color: #d4d5d6;
}

QDialog#ChatDialog #chat_user_list::item:selected {
    background-color: ${color.list.selected};
    border: none;
}

QDialog#ChatDialog #chat_user_list::item:selected:hover {
    background-color: ${color.list.selected.hover};
}

QDialog#ChatDialog #chat_user_list::item:selected:pressed {
    background-color: ${color.list.selected.pressed};
}

QDialog#ChatDialog #chat_user_list:focus {
    border: none;
    outline: none;
}

ChatUserWid {
    background-color: transparent;
    border: none;
}

ChatUserWid#ChatUserWid #user_chat_lb {
    color: ${color.text.preview};
    font-size: ${font.size.label};
}

ChatUserWid#ChatUserWid #user_name_lb {
    color: ${color.text.primary};
    font-size: ${font.size.message};
    font-weight: ${font.weight.medium};
}

ChatUserWid#ChatUserWid #time_lb {
    color: #a0a5ab;
    font-size: ${font.size.caption};
}

ChatUserWid#ChatUserWid #user_name_lb[selected="true"],
ChatUserWid#ChatUserWid #user_chat_lb[selected="true"],
ChatUserWid#ChatUserWid #time_lb[selected="true"] {
    color: ${color.surface};
}

ChatUserWid#ChatUserWid #icon_lb {
    background: #eef0f2;
    border: 1px solid #e0e3e5;
    border-radius: ${radius.avatar};
}

ChatPage #messageSelectionBar {
    background: ${color.surface};
    border-bottom: 1px solid ${color.border.subtle};
}

ChatPage #messageSelectionBar QPushButton {
    background: ${color.surface};
    color: ${color.text.body};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.control};
    padding: 5px 12px;
    min-height: 24px;
}

ChatPage #messageSelectionBar QPushButton:disabled {
    color: ${color.text.muted};
}

QDialog#ChatDialog #chat_page,
QDialog#ChatDialog #chat_page #chat_data_wid {
    background: #f5f5f5;
}

QDialog#ChatDialog #chat_page #composer_wid {
    background: #f5f5f5;
    border: none;
}

/* 输入区独立卡片：外边距在 .ui 中，编辑框和底部工具栏共用背景。 */
QDialog#ChatDialog #chat_page #composer_card {
    background: #fafafa;
    border: 1px solid #dedede;
    border-radius: ${radius.card};
}

QDialog#ChatDialog #chat_page QSplitter#chat_splitter::handle {
    background: transparent;
    border: none;
}

QDialog#ChatDialog #chat_page #title_wid {
    background: #f5f5f5;
    border-bottom: 1px solid #dedede;
}

QDialog#ChatDialog #chat_page #title_label {
    color: ${color.text.primary};
    font-size: ${font.size.heading};
    font-weight: ${font.weight.medium};
}

QDialog#ChatDialog #chat_page #chatEdit {
    background-color: transparent;
    border: none;
    color: #25282c;
    font-size: ${font.size.message};
    padding: 4px 6px;
    selection-background-color: ${color.selection};
}

QDialog#ChatDialog #chat_page #chatEdit:disabled {
    color: #a5aaaf;
    background: transparent;
}

QDialog#ChatDialog #chat_page #tool_wid {
    background-color: transparent;
    border: none;
}

QDialog#ChatDialog #chat_page #send_btn {
    background-color: #f5f5f5;
    color: #07a957;
    font-size: ${font.size.message};
    font-weight: ${font.weight.medium};
    border: 1px solid ${color.surface.pressed};
    border-radius: ${radius.avatar};
}

QDialog#ChatDialog #chat_page #send_btn:hover:enabled {
    background-color: #e9e9e9;
}

QDialog#ChatDialog #chat_page #send_btn:pressed:enabled {
    background-color: #dedede;
}

QDialog#ChatDialog #chat_page #send_btn:disabled {
    background-color: #f1f1f1;
    color: #b8b8b8;
    border-color: #ededed;
}

QDialog#ChatDialog #chat_page #chat_data_list,
QDialog#ChatDialog #chat_page #chat_bg {
    background-color: #f5f5f5;
}

QDialog#ChatDialog #chat_page #chat_area {
    border: none;
}

QDialog#ChatDialog #chat_page #chat_user_name {
    color: #8b929a;
    font-size: ${font.size.label};
}

QDialog#ChatDialog #chat_page QLabel#chat_time_separator {
    color: #a3a3a3;
    background: transparent;
    font-size: ${font.size.small};
    padding: 8px 0 5px 0;
}

QDialog#ChatDialog #chat_page QLabel#message_status {
    color: #999999;
    font-size: ${font.size.caption};
    background: transparent;
}

QDialog#ChatDialog #chat_page QLabel#message_status[failed="true"] {
    color: #d94c4c;
}

QDialog#ChatDialog #chat_page QLabel#chat_status {
    background: #fff5df;
    color: #86632c;
    border: none;
    border-bottom: 1px solid #f0dfb8;
    padding: 7px 22px;
    font-size: ${font.size.small};
}

QDialog#ChatDialog #chat_user_list QLabel#unread_dot {
    background: #fa5151;
    border: none;
    border-radius: ${radius.dot};
}

/* ChatSettingsPanel（chatsettingspanel.ui）：悬浮于聊天内容右侧，不占布局宽度。
   位置由 QPropertyAnimation 平移；背景和左边界明确区分抽屉与聊天内容。 */
QDialog#ChatDialog #chat_page ChatSettingsPanel {
    background: ${color.surface.subtle};
    border: none;
    border-left: 1px solid ${color.border.card};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QWidget,
QDialog#ChatDialog #chat_page ChatSettingsPanel QLabel {
    background: transparent;
    border: none;
    color: ${color.text.primary};
    font-size: ${font.size.message};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel #member_name,
QDialog#ChatDialog #chat_page ChatSettingsPanel #add_member_label {
    color: ${color.text.muted};
    font-size: ${font.size.label};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel #settings_separator_1,
QDialog#ChatDialog #chat_page ChatSettingsPanel #settings_separator_2,
QDialog#ChatDialog #chat_page ChatSettingsPanel #settings_separator_3 {
    background: ${color.border.subtle};
    border: none;
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QPushButton {
    background: transparent;
    border: none;
    border-radius: ${radius.control};
    color: ${color.text.primary};
    font-size: ${font.size.message};
    padding: 0;
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QPushButton:hover {
    background: ${color.surface.hover};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QPushButton:pressed {
    background: ${color.surface.pressed};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel #add_member_btn {
    border: 1px dashed #d7dadd;
    border-radius: ${radius.compact};
}

QDialog#ChatDialog #chat_page ChatSettingsPanel #find_content_btn {
    text-align: left;
}

QDialog#ChatDialog #chat_page ChatSettingsPanel #clear_history_btn {
    color: #fa5151;
}

/* QCheckBox 原生维护 :checked 状态，用两张 SVG 实现开关，不需要自定义 state。 */
QDialog#ChatDialog #chat_page ChatSettingsPanel QCheckBox {
    background: transparent;
    border: none;
    spacing: 0;
    padding: 0;
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QCheckBox::indicator {
    width: 40px;
    height: 24px;
    border: none;
    image: url(:/icons/settings-switch-off.svg);
}

QDialog#ChatDialog #chat_page ChatSettingsPanel QCheckBox::indicator:checked {
    image: url(:/icons/settings-switch-on.svg);
}

/* 标题栏通话菜单由 Qt 管理键盘、焦点、屏幕边界和关闭行为。 */
QMenu#chat_call_menu {
    background: ${color.surface};
    color: ${color.text.primary};
    border: 1px solid ${color.border.card};
    border-radius: ${radius.panel};
    padding: 6px;
    font-size: ${font.size.base};
}

QMenu#chat_call_menu::item {
    border-radius: ${radius.compact};
    padding: 10px 24px 10px 12px;
}

QMenu#chat_call_menu::item:selected {
    background: ${color.surface.hover};
}
