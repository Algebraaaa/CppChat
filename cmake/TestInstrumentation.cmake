include_guard(GLOBAL)
if(CPPCHAT_SANITIZER OR CPPCHAT_COVERAGE)
  if(NOT CPPCHAT_BUILD_TESTS OR MSVC)
    message(FATAL_ERROR "Instrumentation requires a Linux test build")
  endif()
  if(CPPCHAT_SANITIZER AND CPPCHAT_COVERAGE)
    message(FATAL_ERROR "Use separate sanitizer and coverage builds")
  endif()
  if(CPPCHAT_SANITIZER)
    if(NOT CPPCHAT_SANITIZER MATCHES "^(address|undefined|thread)$")
      message(FATAL_ERROR "Unknown sanitizer")
    endif()
    add_compile_options(-fsanitize=${CPPCHAT_SANITIZER} -fno-omit-frame-pointer -g)
    add_link_options(-fsanitize=${CPPCHAT_SANITIZER})
  else()
    add_compile_options(--coverage -O0 -g)
    add_link_options(--coverage)
  endif()
endif()
